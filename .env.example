# Cloud sync (optional). Copy this file to .env.local and fill both in.
#
# Supabase → your project → Settings → API:
#   Project URL          -> VITE_SUPABASE_URL
#   Project API keys → anon / public  -> VITE_SUPABASE_ANON_KEY
#
# The anon key is MEANT to be public — it ships inside the app bundle and identifies
# the project, not you. What actually protects the data is row level security, which
# supabase/schema.sql turns on in the same migration that creates the table. Never
# put the `service_role` key here: that one bypasses RLS entirely.
#
# Leave these unset and Pitchwork simply has no sync — every other part of the app
# behaves exactly as it did before.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
